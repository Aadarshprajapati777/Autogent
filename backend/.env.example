# Production environment configuration
# Copy to .env and fill in real values before deploying.

# ── core ──
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://autogent:CHANGE_ME@db:5432/autogent
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
LOG_LEVEL=INFO

# ── auth (required) ──
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_BASE64_FERNET_KEY

# ── LLM ──
# Provider: gemini (default, uses Google Gemini 3.5 Flash), cerebras, or openai
AI_PROVIDER=gemini

# ── Google Gemini / Vertex AI ──
# Option A — Gemini Developer API (simplest, set GEMINI_API_KEY):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Option B — Vertex AI / Agent Platform (for Google Cloud deployment):
# USE_VERTEX_AI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Use Google ADK as the agent framework for the chat agent
USE_ADK_AGENT=true

# ── Cerebras (fallback) ──
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# ── Slack ──
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── GitHub ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Recall.ai ──
RECALL_API_KEY=
RECALL_SVIX_WEBHOOK_SECRET=

# ── email ──
# Email sending is disabled by default. Set to true to enable SMTP delivery.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ── payments ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Postgres (for docker-compose) ──
POSTGRES_PASSWORD=CHANGE_ME
