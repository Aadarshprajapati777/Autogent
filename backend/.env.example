# ── core ──
DATABASE_URL=postgresql+psycopg://autogent:autogent@localhost:5432/autogent
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

# ── auth (Clerk) ──
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
JWT_SECRET_KEY=autogent-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# ── credentials vault ──
CREDENTIAL_ENCRYPTION_KEY=

# ── LLM (Cerebras is the default agent brain) ──
AI_PROVIDER=cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENAI_API_KEY=
AGENT_MAX_STEPS=8
AGENT_MODEL_TEMPERATURE=0.2

# ── Slack ──
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── integrations ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Recall.ai (meeting bot) ──
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_WORKSPACE_VERIFICATION_SECRET=
RECALL_SVIX_WEBHOOK_SECRET=

# ── email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@autogent.ai

# ── payments (Razorpay) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ── misc ──
REPORTS_DIR=/tmp/autogent-reports
MONITORING_HOUR_UTC=3
